{
  "info": {
    "name": "DuoDot API",
    "description": "DuoDot - Romantic Memories Sharing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"countryCode\": \"+91\",\n  \"phoneNumber\": \"9876543210\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"pinId\": \"560001\"\n}"
            }
          }
        },
        {
          "name": "Confirm Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/confirm-signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "confirm-signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"User_xxxxx\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/signin",
              "host": ["{{base_url}}"],
              "path": ["auth", "signin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            }
          }
        },
        {
          "name": "Upload Profile Picture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/profile/picture",
              "host": ["{{base_url}}"],
              "path": ["users", "profile", "picture"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/profile.jpg"
                }
              ]
            }
          }
        },
        {
          "name": "Search User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/search?username=jane_doe",
              "host": ["{{base_url}}"],
              "path": ["users", "search"],
              "query": [
                {
                  "key": "username",
                  "value": "jane_doe"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/account",
              "host": ["{{base_url}}"],
              "path": ["users", "account"]
            }
          }
        }
      ]
    },
    {
      "name": "Pairs",
      "item": [
        {
          "name": "Send Pair Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pairs/request?username=jane_doe",
              "host": ["{{base_url}}"],
              "path": ["pairs", "request"],
              "query": [
                {
                  "key": "username",
                  "value": "jane_doe"
                }
              ]
            }
          }
        },
        {
          "name": "Get Pending Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pairs/requests/pending",
              "host": ["{{base_url}}"],
              "path": ["pairs", "requests", "pending"]
            }
          }
        },
        {
          "name": "Accept Pair Request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pairs/requests/1/accept",
              "host": ["{{base_url}}"],
              "path": ["pairs", "requests", "1", "accept"]
            }
          }
        },
        {
          "name": "Reject Pair Request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pairs/requests/1/reject",
              "host": ["{{base_url}}"],
              "path": ["pairs", "requests", "1", "reject"]
            }
          }
        },
        {
          "name": "Get Paired User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pairs/partner",
              "host": ["{{base_url}}"],
              "path": ["pairs", "partner"]
            }
          }
        },
        {
          "name": "Unpair",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pairs/unpair",
              "host": ["{{base_url}}"],
              "path": ["pairs", "unpair"]
            }
          }
        }
      ]
    },
    {
      "name": "Memories",
      "item": [
        {
          "name": "Create Memory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories",
              "host": ["{{base_url}}"],
              "path": ["memories"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Our First Date",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Had a wonderful dinner at the beach",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "/path/to/photo.jpg"
                }
              ]
            }
          }
        },
        {
          "name": "Get Memories (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories?page=0&size=10",
              "host": ["{{base_url}}"],
              "path": ["memories"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Memory by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1",
              "host": ["{{base_url}}"],
              "path": ["memories", "1"]
            }
          }
        },
        {
          "name": "Update Memory",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1",
              "host": ["{{base_url}}"],
              "path": ["memories", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Add Media to Memory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1/media",
              "host": ["{{base_url}}"],
              "path": ["memories", "1", "media"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "/path/to/new_photo.jpg"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Memory",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1",
              "host": ["{{base_url}}"],
              "path": ["memories", "1"]
            }
          }
        },
        {
          "name": "Get Memory Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/count",
              "host": ["{{base_url}}"],
              "path": ["memories", "count"]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1/comments?description=This is a beautiful memory!",
              "host": ["{{base_url}}"],
              "path": ["memories", "1", "comments"],
              "query": [
                {
                  "key": "description",
                  "value": "This is a beautiful memory!"
                }
              ]
            }
          }
        },
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1/comments",
              "host": ["{{base_url}}"],
              "path": ["memories", "1", "comments"]
            }
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/memories/1/comments/1?description=Updated comment",
              "host": ["{{base_url}}"],
              "path": ["memories", "1", "comments", "1"],
              "query": [
                {
                  "key": "description",
                  "value": "Updated comment"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
